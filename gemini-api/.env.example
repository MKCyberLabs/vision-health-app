# Python API listener
FLASK_HOST=172.17.0.1
FLASK_PORT=5000
FLASK_DEBUG=false

# Absolute path to the authenticated Antigravity CLI.
AGY_PATH=/usr/local/bin/agy

# Provider routing. Existing installations remain on agy unless changed here.
ANALYSIS_TEXT_PROVIDER=agy
ANALYSIS_IMAGE_PROVIDER=agy
ANALYSIS_FALLBACK_PROVIDER=none
ANALYSIS_TIMEOUT_SECONDS=300

# Antigravity subscription-backed provider
AGY_TEXT_MODEL=gemini-3.8-flash-low
AGY_IMAGE_MODEL=gemini-3.8-flash-low
AGY_SKIP_PERMISSIONS=true
AGY_USE_JSON_SCHEMA=false

# Legacy names are still accepted when AGY_*_MODEL is absent.
# GEMINI_TEXT_MODEL=gemini-3.8-flash-low
# GEMINI_IMAGE_MODEL=gemini-3.8-flash-low

# OpenRouter provider (optional)
# OPENROUTER_API_KEY=
# OPENROUTER_TEXT_MODEL=google/gemini-2.5-flash
# OPENROUTER_IMAGE_MODEL=google/gemini-2.5-flash
# OPENROUTER_SITE_URL=https://example.com
# OPENROUTER_APP_NAME=NutriSnap

# Direct Google provider (optional)
# GOOGLE_API_KEY=
# GOOGLE_TEXT_MODEL=gemini-3.8-flash
# GOOGLE_IMAGE_MODEL=gemini-3.8-flash

# Keep request-level provider changes disabled in production.
ALLOW_PROVIDER_OVERRIDE=false
